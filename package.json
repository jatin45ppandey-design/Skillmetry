{
  "name": "skillmetry",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "lint": "eslint frontend/src backend shared tests scripts vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm --prefix frontend run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "npx supabase test db --workdir database",
    "verify:assessment": "node --env-file-if-exists=frontend/.env.local scripts/verify-assessment-flow.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:backend": "node scripts/verify-backend-gates.mjs",
    "release:preflight": "node --env-file-if-exists=frontend/.env.local scripts/release-preflight.mjs",
    "release:preflight:readonly": "node --env-file-if-exists=frontend/.env.local scripts/release-preflight.mjs --remote-readonly"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.53.0",
    "@xyflow/react": "^12.8.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.4",
    "zod": "^3.25.76",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.5.0",
    "postcss": "^8.5.6",
    "supabase": "^2.120.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
