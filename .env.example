# No external services are required for anonymous demo mode.
# These are public project identifiers from Supabase Connect, not secret keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Non-secret server-side display/route gates. Keep false until each OAuth provider
# is enabled with its Client ID/Secret in Supabase Dashboard > Authentication > Providers.
GOOGLE_OAUTH_ENABLED=false
GITHUB_OAUTH_ENABLED=false

# Server-only credential used by authenticated assessment routes to create trusted
# quiz sessions and results. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Legacy fallback for projects that have not migrated to secret API keys.
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-only completion-window policy. Leave both blank for immediate retakes.
ASSESSMENT_MAX_COMPLETIONS=
ASSESSMENT_WINDOW_MINUTES=

# Phase D v2026.3 (30-item banks / 15-item sessions / topic evidence).
# Leave OFF until the additive 202610160001 migration passes staging,
# receives owner approval, and is applied to your intended Supabase project.
NEXT_PUBLIC_DIAGNOSTIC_ASSESSMENTS_ENABLED=false

# Keep provider secrets out of NEXT_PUBLIC_*.
GEMINI_API_KEY=

# Keep false until the expanded assessment SQL migration is approved and applied.
NEXT_PUBLIC_EXPANDED_ASSESSMENTS_ENABLED=false

# Fixed application origin for safe password reset email links.
# Use HTTPS in production. Register /auth/callback in Supabase Auth redirect allowlist.
SKILLMETRY_SITE_URL=

# Atomic PostgreSQL account/email throttling (staged; requires 202610160003 migration).
SKILLMETRY_DB_RATE_LIMITING_ENABLED=false

# P3–P6 workflows: enable only after 202610160004 staging RLS review and hosted approval.
NEXT_PUBLIC_LEARNING_WORKFLOWS_ENABLED=false

# P8: external AI tutor opt-in requires server credential, active DB limiter and separate rollout approval.
SKILLMETRY_AI_TUTOR_ENABLED=false

# P9: BOTH toggles default false until migration + hosted privacy review.
SKILLMETRY_PASSPORT_SHARING_ENABLED=false
NEXT_PUBLIC_PASSPORT_SHARING_ENABLED=false

# P10: restricted server-side /api/health/ready probe token, set in the deployment secret store.
SKILLMETRY_HEALTHCHECK_TOKEN=

# Backend-first consistency streak: disabled until migration 006 and pgTAP/E2E validation.
SKILLMETRY_STREAKS_ENABLED=false

# Frontend streak calendar: enable only together with reviewed server streak migration 006.
NEXT_PUBLIC_LEARNING_STREAK_ENABLED=false

# Disabled until the Admin Studio migration and explicit owner enrollment are verified.
SKILLMETRY_ADMIN_STUDIO_ENABLED=false
