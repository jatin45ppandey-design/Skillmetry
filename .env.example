# No external services are required for anonymous demo mode.
# These are public project identifiers from Supabase Connect, not secret keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only credential used by authenticated assessment routes to create trusted
# quiz sessions and results. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Legacy fallback for projects that have not migrated to secret API keys.
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-only completion-window policy. Leave both blank for immediate retakes.
ASSESSMENT_MAX_COMPLETIONS=
ASSESSMENT_WINDOW_MINUTES=

# Keep provider secrets out of NEXT_PUBLIC_*.
GEMINI_API_KEY=
