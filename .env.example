# No external services are required for anonymous demo mode.
# These are public project identifiers from Supabase Connect, not secret keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Keep all secret/service-role keys out of NEXT_PUBLIC_* and out of this app.
# A future trusted grading/review worker must use separately managed server secrets.
GEMINI_API_KEY=
