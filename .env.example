# No external services are required for anonymous demo mode.
# These are public project identifiers from Supabase Connect, not secret keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Non-secret server-side display/route gates. Keep false until each OAuth provider
# is enabled with its Client ID/Secret in Supabase Dashboard > Authentication > Providers.
GOOGLE_OAUTH_ENABLED=false
GITHUB_OAUTH_ENABLED=false

# Server-only credential used by authenticated assessment routes to create trusted
# quiz sessions and results. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Legacy fallback for projects that have not migrated to secret API keys.
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-only completion-window policy. Leave both blank for immediate retakes.
ASSESSMENT_MAX_COMPLETIONS=
ASSESSMENT_WINDOW_MINUTES=

# Phase D v2026.3 (30-item banks / 15-item sessions / topic evidence).
# Leave OFF until the additive 202610160001 migration passes staging,
# receives owner approval, and is applied to your intended Supabase project.
NEXT_PUBLIC_DIAGNOSTIC_ASSESSMENTS_ENABLED=false

# Keep provider secrets out of NEXT_PUBLIC_*.
GEMINI_API_KEY=

# Phase 2 optional AI. Never enable until the AI quota SQL migration is
# approved/applied and the Gemini key + billing limits are configured.
SKILLMETRY_AI_ENABLED=false

# Destructive account deletion requires validated staging/security approval.
ACCOUNT_DELETION_ENABLED=false
GEMINI_MODEL=gemini-2.5-flash
